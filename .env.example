# Copy to backend/.env and fill in. Never commit real secrets.

# --- database (docker-compose Postgres)
DATABASE_URL=postgresql+psycopg://academy:academy@localhost:5432/academy
PUBLIC_WEB_URL=http://localhost:3000

# --- AI (Claude). Set AI_PROVIDER=fake to run fully offline (labelled heuristic grading, placeholder lessons).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=50
# Optional per-role overrides (default claude-opus-5-5 for every role):
# AI_MODEL_TUTOR=claude-sonnet-5-5
# AI_MODEL_RESEARCHER=claude-haiku-5-5

# --- sandbox for student code: build the image with `make sandbox-image`
SANDBOX_BACKEND=docker
# SANDBOX_BACKEND=unsafe-local and SANDBOX_ALLOW_UNSAFE_LOCAL=true run code WITHOUT isolation (dev only)

# --- email: console (writes .eml files to backend/var/outbox), smtp (Mailpit), or resend
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=AI Academy <academy@localhost>
# RESEND_API_KEY=

# --- mastery thresholds (fractions)
# THRESHOLD_LESSON=0.85
# THRESHOLD_CODING=0.90
# THRESHOLD_CRITICAL_OBJECTIVE=0.85
